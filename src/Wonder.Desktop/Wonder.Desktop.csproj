<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Wonder.Desktop</AssemblyName>
    <RootNamespace>Wonder.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Wonder.Desktop.Tests" />
    <AvaloniaResource Include="Assets/InstanceIcons/*.png" />
    <EmbeddedResource Include="Plugins/index.json" LogicalName="Wonder.PluginCatalog" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <ProjectReference Include="../Wonder.Workspace/Wonder.Workspace.csproj" />
    <ProjectReference Include="../Wonder.Extensibility.Contracts/Wonder.Extensibility.Contracts.csproj" />
    <ProjectReference Include="../Wonder.Extensibility/Wonder.Extensibility.csproj" />
    <ProjectReference Include="../Wonder.Application/Wonder.Application.csproj" />
    <ProjectReference Include="../Wonder.Infrastructure/Wonder.Infrastructure.csproj" />
  </ItemGroup>
  <Target Name="ExcludePackageDebugSymbols" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
  <Target Name="ExternalizeThirdPartyDependencies" BeforeTargets="_ComputeFilesToBundle"
          Condition="'$(WonderExternalDependencies)' == 'true'">
    <Error Condition="'$(SelfContained)' != 'false' or '$(PublishSingleFile)' != 'true'"
           Text="WonderExternalDependencies requires a framework-dependent single-file publish." />
    <ItemGroup>
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)"
                            Condition="'%(ResolvedFileToPublish.Extension)' == '.dll' and !$([System.String]::Copy('%(ResolvedFileToPublish.Filename)').StartsWith('Wonder.'))">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
